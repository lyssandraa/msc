# Copy this file to .env.local and fill in the values from your Supabase
# project's Settings -> API page. .env.local is gitignored, never commit it.
#
# These VITE_ vars are inlined into the client bundle at build time and are
# meant to be public - security comes from Supabase's row level security
# policies, not from keeping this key secret. Never put the service_role
# key here or in any VITE_ var; it belongs only in Vercel's server-side
# environment variables (see docs/ARCHITECTURE.md).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only, used exclusively by api/invite-user.js. Vercel injects every
# env var into serverless functions regardless of the VITE_ prefix - the
# prefix only controls what Vite inlines into the *client* bundle - so this
# one is deliberately left unprefixed and must never be added to a VITE_
# variable. In production this only ever lives in Vercel's dashboard, never
# committed; it's here only so `vercel dev` can run the invite endpoint
# locally. Find it in Supabase under Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-SECRET-KEY

# Server-only, used exclusively by api/notify-applicant.js to email an
# applicant when their status is set to accepted/rejected. Get this from
# resend.com -> API Keys. Emails only deliver to your own Resend account
# email until you verify a sending domain there - see docs/ARCHITECTURE.md.
RESEND_API_KEY=YOUR-RESEND-API-KEY
# Optional: defaults to Resend's shared sandbox sender if unset. Set this
# once you've verified a domain in Resend, e.g. committee@yourdomain.org.
RESEND_FROM_EMAIL=onboarding@resend.dev
